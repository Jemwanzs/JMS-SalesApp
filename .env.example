# ------------------------------------------------------------------
# JMS Sales App — environment variables
# Copy this file to .env.local for local development and fill in real
# values. NEVER commit .env.local (it is gitignored) or paste real
# secrets into docs, commits, or chat.
# ------------------------------------------------------------------

# --- Supabase --------------------------------------------------------
# Project URL and anon (public) key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER-ONLY. Bypasses RLS entirely. Never import
# lib/supabase/service-role.ts from client code. Used only by webhook
# handlers, cron routes, and PlatformAdminService.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------
# Base URL of this deployment, used for building absolute links in
# emails/invites and for constructing redirect URLs.
NEXT_PUBLIC_APP_URL=https://jms-sales.vercel.app
NODE_ENV=development

# --- Paystack ----------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Shared secret used to verify inbound webhook signatures.
PAYSTACK_WEBHOOK_SECRET=

# --- Monitoring (Sentry) ------------------------------------------------
# Wired in (instrumentation.ts, instrumentation-client.ts, next.config.ts)
# as of the hardening roadmap's Phase 4.1 -- safe to leave all four blank
# (Sentry.init({dsn: undefined}) is a supported no-op, and the build-time
# source-map upload just skips itself with a warning), but nothing gets
# reported anywhere until a real DSN exists. NEXT_PUBLIC_SENTRY_DSN is
# meant to be public (embedded in client-side code by Sentry's own
# design) -- the other three are real secrets, only for CI/build-time
# source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Rate limiting (Upstash Redis) ----------------------------------------
# Wired in (lib/rate-limit.ts) as of the hardening roadmap's Phase 4.3 --
# safe to leave both blank: sign-up/password-reset rate limiting fails
# OPEN (allows every request) with no Upstash configured, rather than
# silently breaking those forms for everyone before the account exists.
# REST-based (no persistent connection), works from Vercel's serverless
# and edge runtimes alike.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron / internal job auth --------------------------------------------
# Shared secret checked by app/api/cron/outbox so the route can't be
# triggered by arbitrary public requests. Set the same value in Vercel
# Cron's configured header/query param.
CRON_SECRET=

# --- Platform admin bootstrap --------------------------------------------
# Email seeded as the first platform_admins row (super_admin) by
# supabase/seeds. Architecture supports multiple admins afterward —
# this is only used once, at initial seed time, never checked in app logic.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=jamosammy@gmail.com

# --- Demo walkthrough video (scripts/demo-video/, docs/25) ---------------
# Login for the dedicated demo tenant's Sales User account only -- never a
# real tenant. Not read by the app itself, only by scripts/demo-video/
# record.mjs.
DEMO_VIDEO_EMAIL=
DEMO_VIDEO_PASSWORD=
DEMO_VIDEO_BASE_URL=http://127.0.0.1:3000
