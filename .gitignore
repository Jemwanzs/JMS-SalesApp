# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is the committed template — never commit real secrets)
.env*
!.env.example

# vercel
.vercel

# local editor/tooling state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts/build-user-guide-pdf.mjs's intermediate HTML -- public/docs/User-Guide.pdf is the committed artifact
/scripts/user-guide-preview.html
